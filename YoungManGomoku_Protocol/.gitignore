# Build results
/bin/
/obj/

# Visual Studio artifacts
# Rider / Visual Studio Project User Files
*.user
*.rsuser
*.suo
*.cache
*.sqlite

# Logs
*.log

# ASP.NET Core Secrets & Config
# User Secrets (security issue)  (ex. API Key, DB Password...)
**/appsettings.Development.json
**/appsettings.Local.json
*.local.json
secrets.json

# Environment variable files  (security issue)
.env
.env.*

# ASP.NET Publishing output
# For Release Only
/publish/
/**/publish/
/**/wwwroot/dist/
/**/wwwroot/node_modules/

# EF Core
# Entity Framework Migrations build artifacts
*Migrations/*.Designer.cs
*Migrations/*ModelSnapshot.cs

# IIS Express
/.vs/
/iisexpress/
App_Data/

# NuGet
*.nupkg
.nuget/
packages/

