  gomokuWin:
    mainText: "\uC2B9\uB9AC"
    detailText: "\uC624\uBAA9\uC73C\uB85C \uC2B9\uB9AC\uD558\uC600\uC2B5\uB2C8\uB2E4."
  gomokuLose:
    mainText: "\uD328\uBC30"
    detailText: "\uC0C1\uB300\uBC29\uC758 \uC624\uBAA9\uC73C\uB85C \uD328\uBC30\uD558\uC600\uC2B5\uB2C8\uB2E4."
  unmovableWin:
    mainText: "\uAE08\uC218\uC2B9"
    detailText: "\uC0C1\uB300\uBC29\uC758 \uAE08\uC218\uD328\uB85C \uC2B9\uB9AC\uD558\uC600\uC2B5\uB2C8\uB2E4."
  unmovableLose:
    mainText: "\uAE08\uC218\uD328"
    detailText: "\uCC29\uC218 \uAC00\uB2A5\uD55C \uC790\uB9AC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  surrenderWin:
    mainText: "\uAE30\uAD8C\uC2B9"
    detailText: "\uC0C1\uB300\uBC29\uC774 \uAC8C\uC784\uC744 \uD3EC\uAE30\uD558\uC600\uC2B5\uB2C8\uB2E4."
  surrenderLose:
    mainText: "\uAE30\uAD8C\uD328"
    detailText: "\uAC8C\uC784\uC744 \uD3EC\uAE30\uD558\uC168\uC2B5\uB2C8\uB2E4."
  timeoutWin:
    mainText: "\uC2DC\uAC04\uC2B9"
    detailText: "\uC0C1\uB300\uBC29\uC774 \uC2DC\uAC04\uC744 \uBAA8\uB450 \uC0AC\uC6A9\uD558\uC600\uC2B5\uB2C8\uB2E4."
  timeoutLose:
    mainText: "\uC2DC\uAC04\uD328"
    detailText: "\uC2DC\uAC04\uC744 \uBAA8\uB450 \uC0AC\uC6A9\uD558\uC5EC \uD328\uBC30
      \uCC98\uB9AC\uB429\uB2C8\uB2E4."
  disconnectedWin:
    mainText: "\uC811\uC18D\uB04A\uAE40\uC2B9"
    detailText: "\uC0C1\uB300\uBC29\uC758 \uC811\uC18D\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  disconnectedLose:
    mainText: "\uC811\uC18D\uB04A\uAE40\uD328"
    detailText: "\uC811\uC18D\uC774 \uB04A\uACA8 \uD328\uBC30 \uCC98\uB9AC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  draw:
    mainText: "\uBB34\uC2B9\uBD80"
    detailText: "\uD310\uC744 \uBAA8\uB450 \uCC44\uC6CC \uBB34\uC2B9\uBD80 \uCC98\uB9AC\uB429\uB2C8\uB2E4."
  error:
    mainText: 
    detailText: "\uC11C\uBC84 \uD1B5\uC2E0\uC5D0 \uC2E4\uD328\uD558\uC600\uC2B5\uB2C8\uB2E4."
