  oppositeDisconnectedText: "\uC0C1\uB300\uBC29\uC758 \uC811\uC18D\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  playerDisconnectedText: "\uC811\uC18D\uC774 \uB04A\uACA8 \uD328\uBC30 \uCC98\uB9AC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
